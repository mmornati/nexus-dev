{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Nexus-Dev MCP Configuration",
    "type": "object",
    "definitions": {
        "cacheSettings": {
            "type": "object",
            "description": "Cache configuration for tool invocation results",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "ttl_seconds": {
                    "type": "number",
                    "description": "Time to live for cache entries in seconds",
                    "default": 300,
                    "minimum": 1
                },
                "max_entries": {
                    "type": "integer",
                    "description": "Maximum number of cache entries",
                    "default": 1000,
                    "minimum": 1
                }
            }
        },
        "summarizeSettings": {
            "type": "object",
            "description": "Summarization configuration for tool outputs",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "max_list_items": {
                    "type": "integer",
                    "description": "Maximum number of items to show in lists",
                    "default": 10,
                    "minimum": 1
                },
                "max_output_chars": {
                    "type": "integer",
                    "description": "Maximum number of characters in output",
                    "default": 500,
                    "minimum": 1
                }
            }
        }
    },
    "properties": {
        "version": {
            "type": "string",
            "description": "Schema version",
            "const": "1.0"
        },
        "servers": {
            "type": "object",
            "description": "MCP server configurations",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean",
                        "default": true
                    },
                    "transport": {
                        "type": "string",
                        "enum": [
                            "stdio",
                            "sse",
                            "http"
                        ],
                        "default": "stdio",
                        "description": "Transport type: stdio (local process) or sse (HTTP remote)"
                    },
                    "command": {
                        "type": "string",
                        "description": "Command to start the MCP server (required for stdio)"
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": []
                    },
                    "env": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "default": {}
                    },
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Server URL (required for sse)"
                    },
                    "headers": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "default": {},
                        "description": "HTTP headers for SSE connection"
                    },
                    "timeout": {
                        "type": "number",
                        "description": "Tool execution timeout in seconds",
                        "default": 30,
                        "minimum": 1
                    },
                    "connect_timeout": {
                        "type": "number",
                        "description": "Connection timeout in seconds",
                        "default": 10,
                        "minimum": 1
                    },
                    "max_concurrent": {
                        "type": "integer",
                        "description": "Maximum concurrent invocations for this server (overrides gateway default)",
                        "minimum": 1
                    },
                    "cache": {
                        "$ref": "#/definitions/cacheSettings",
                        "description": "Server-specific cache settings (overrides gateway default)"
                    },
                    "summarize": {
                        "$ref": "#/definitions/summarizeSettings",
                        "description": "Server-specific summarize settings (overrides gateway default)"
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "transport": {
                                    "const": "stdio"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "command"
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "transport": {
                                    "const": "sse"
                                }
                            },
                            "required": [
                                "transport"
                            ]
                        },
                        "then": {
                            "required": [
                                "url"
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "transport": {
                                    "const": "http"
                                }
                            },
                            "required": [
                                "transport"
                            ]
                        },
                        "then": {
                            "required": [
                                "url"
                            ]
                        }
                    }
                ]
            }
        },
        "profiles": {
            "type": "object",
            "description": "Named profiles mapping to server lists",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "default": {}
        },
        "gateway": {
            "type": "object",
            "description": "Global gateway settings",
            "properties": {
                "default_timeout": {
                    "type": "number",
                    "description": "Default tool execution timeout",
                    "default": 30,
                    "minimum": 1
                },
                "max_concurrent_connections": {
                    "type": "integer",
                    "description": "Maximum concurrent connections to backend servers",
                    "default": 5,
                    "minimum": 1
                },
                "shutdown_timeout": {
                    "type": "number",
                    "description": "Graceful shutdown timeout in seconds",
                    "default": 5,
                    "minimum": 0
                },
                "cache": {
                    "$ref": "#/definitions/cacheSettings",
                    "description": "Global cache settings"
                },
                "summarize": {
                    "$ref": "#/definitions/summarizeSettings",
                    "description": "Global summarize settings"
                }
            }
        },
        "active_profile": {
            "type": "string",
            "description": "The currently active profile",
            "default": "default"
        }
    },
    "required": [
        "version",
        "servers"
    ]
}